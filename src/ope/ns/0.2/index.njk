<!-- Withdrawn -->
<section class="py-16 border-t border-zinc-900/5">
  <div class="max-w-3xl mx-auto px-6 lg:px-8">
    <h2 class="text-xs font-semibold text-zinc-900 mb-3">Changed from v0.1</h2>
    <p class="text-sm text-zinc-600 leading-relaxed">The v0.1 elements <code>ope:access</code>, <code>ope:content-id</code>, <code>ope:grant-types</code>, <code>ope:type</code>, <code>ope:metadata</code> and its children, and <code>ope:unlock-url</code> are withdrawn along with the <a href="{{ '/ope/ns/1.0/' | url }}" class="text-emerald-700 underline">ns/1.0</a> namespace. <code>ope:offer</code> replaces <code>ope:access</code>; prices live in the Offer; word counts, durations, and episode numbers come from the feed's own elements and the Podcasting 2.0 namespace.</p>
  </div>
</section>
